# API key from https://restcountries.com (sent as "Authorization: Bearer <key>")
RESTCOUNTRIES_API_KEY=

# Base URL of the upstream provider
RESTCOUNTRIES_BASE_URL=https://api.restcountries.com/countries/v5

# Port this middleware listens on
PORT=3000

# How long (in seconds) the countries dataset stays cached in memory
CACHE_TTL_SECONDS=21600

# Max time (in milliseconds) to wait for each upstream call
UPSTREAM_TIMEOUT_MS=8000
